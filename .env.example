# OpenAI の API キー。このファイルをコピーして .env を作り、値を書き込む。
#
#   cp .env.example .env
#
# .env は .gitignore 済み。**絶対にコミットしない**。
# ここに置かず ~/.gradle/gradle.properties に openAiApiKey として書いてもよい
# （SDK 取得の PAT と同じ場所。リポジトリの外なので混入しようがない）。
#
# 探す順 = .env → local.properties → ~/.gradle/gradle.properties → 環境変数
OPENAI_API_KEY=

# 使うモデル。空なら gpt-4o を使う
OPENAI_MODEL=gpt-5.6-luna

# 推論の強さ。**推論するモデルでは none にする**。
#
# 待ち時間がそのまま伸びるうえ、推論トークンは出力と枠を共用するので、使い切ると本文が空で返る。
# 解説のプロンプト（4〜5 文・250 文字）で実測したところ、切らないと 4 回中 4 回が空だった
# （finish_reason が length になる）。切ると 4/4 成功して 2〜3 秒で返る。
#
# 推論を持たないモデル（gpt-4o など）に送ると 400 で弾かれるので、そのときは**空にする**。
# 空なら送らない。
OPENAI_REASONING_EFFORT=none

# 読み上げの声。空なら既定値（下記）を使う。
# OPENAI_TTS_MODEL を tts-1 にすると話し方の指示が効かず、棒読みに戻る
OPENAI_TTS_MODEL=gpt-4o-mini-tts
# alloy / ash / ballad / coral / echo / fable / nova / onyx / sage / shimmer / verse
OPENAI_TTS_VOICE=alloy
