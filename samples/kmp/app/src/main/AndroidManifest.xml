<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.BLUETOOTH" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADMIN" />
    <uses-permission android:name="android.permission.BLUETOOTH_SCAN" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <!-- 観測地の測位。Android 12 以降は FINE だけだと「おおよその位置」を選ばれたときに落ちる -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.REQUEST_OBSERVE_COMPANION_DEVICE_PRESENCE" />
    <!-- AI 解説の生成。OpenAI を叩くのはここだけ -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- 圏外かどうかを喋り分けるために回線の状態を見る -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!--
        読み上げと BGM の音量を、つまみの上限より上へ持ち上げる（LoudnessBoost）。
        夜の屋外でスマホのスピーカーから鳴らすので、1.0 では足りない。
        インストール時に付く権限で、実行時に聞かれることはない。
    -->
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />

    <uses-feature
        android:name="android.hardware.bluetooth_le"
        android:required="true" />
    <uses-feature
        android:name="android.software.companion_device_setup"
        android:required="true" />

    <application
        android:name=".SaberaApplication"
        android:label="星しるべ"
        android:supportsRtl="true"
        android:theme="@style/Theme.Sabera">

        <!--
            縦固定。**回転で Activity が作り直されると観測がやり直しになる。**
            星表の再読込だけでなく、グラスに置いたテキスト枠の記憶（shownElements）まで消えるので
            前のラベルが画面に残り、解説画面を出している最中だと文字を消せなくなる。
            方位合わせは「スマホを顔の前にかざす」操作なので、観測の入口がいちばん回転しやすい。
        -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:screenOrientation="portrait">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name="app.jigglass.ble.BleCompanionDeviceService"
            android:exported="true"
            android:permission="android.permission.BIND_COMPANION_DEVICE_SERVICE">
            <intent-filter>
                <action android:name="android.companion.CompanionDeviceService" />
            </intent-filter>
        </service>
    </application>
</manifest>
